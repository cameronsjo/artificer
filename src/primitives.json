  "versions": {
    "0.10.1": {
      "title": "v0.10.0 + v0.10.1 \u2014 navigation wave, SPA lifecycle, brandPurple ramp split (shipped as ONE commit; no consumer was ever on 0.10.0)",
      "minted": [
        "appbar",
        "sidenav",
        "nav-drawer",
        "crumb",
        "avatar",
        "tabs",
        "accordion",
        "dash",
        "wordmark",
        "editorial",
        "breakpoints",
        "focus-ring"
      ],
      "breaking": [
        {
          "kind": "repurpose",
          "what": "--t-*-size type-scale tokens",
          "from": "px values",
          "to": "rem values",
          "why": "px overrides fight the scale and break browser zoom",
          "adr": "0031"
        },
        {
          "kind": "rename",
          "what": "localStorage theme key",
