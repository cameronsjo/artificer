{
  "document": {
    "block_prefix": "\n",
    "block_suffix": "\n",
    "color": "#20203e",
    "margin": 2
  },
  "block_quote": {
    "color": "#4a3f2a",
    "indent": 1,
    "indent_token": "│ "
  },
  "paragraph": {},
  "list": {
    "level_indent": 2
  },
  "heading": {
    "block_suffix": "\n",
    "color": "#7a5a10",
    "bold": true
  },
  "h1": {
    "prefix": " ",
    "suffix": " ",
    "color": "#f5ead0",
    "background_color": "#7a5a10",
    "bold": true
  },
  "h2": {
    "prefix": "▌ ",
    "color": "#866010"
  },
  "h3": {
    "prefix": "▎ "
  },
  "h4": {
    "prefix": "▏ "
  },
  "h5": {
    "prefix": "· "
  },
  "h6": {
    "prefix": "· ",
    "color": "#4a3f2a",
    "bold": false
  },
  "text": {},
  "strikethrough": {
    "crossed_out": true
  },
  "emph": {
    "italic": true
  },
  "strong": {
    "bold": true
  },
  "hr": {
    "color": "#cbb88a",
    "format": "\n────────────────────────────────────────────────────────────────────────\n"
  },
  "item": {
    "block_prefix": "• "
  },
  "enumeration": {
    "block_prefix": ". "
  },
  "task": {
    "ticked": "[✓] ",
    "unticked": "[ ] "
  },
  "link": {
    "color": "#3a6a68",
    "underline": true
  },
  "link_text": {
    "color": "#866010",
    "bold": true
  },
  "image": {
    "color": "#5a35b0",
    "underline": true
  },
  "image_text": {
    "color": "#4a3f2a",
    "format": "Image: {{.text}} →"
  },
  "code": {
    "prefix": " ",
    "suffix": " ",
    "color": "#3a7050",
    "background_color": "#eddcc0"
  },
  "code_block": {
    "color": "#20203e",
    "margin": 2,
    "chroma": {
      "text": {
        "color": "#20203e"
      },
      "error": {
        "color": "#a04540"
      },
      "comment": {
        "color": "#5a7a8a"
      },
      "comment_preproc": {
        "color": "#5a35b0"
      },
      "keyword": {
        "color": "#5a35b0"
      },
      "keyword_reserved": {
        "color": "#5a35b0"
      },
      "keyword_namespace": {
        "color": "#3a6a68"
      },
      "keyword_type": {
        "color": "#866010"
      },
      "operator": {
        "color": "#5a7a8a"
      },
      "punctuation": {
        "color": "#5a7a8a"
      },
      "name": {
        "color": "#20203e"
      },
      "name_builtin": {
        "color": "#7a5a10"
      },
      "name_tag": {
        "color": "#a04540"
      },
      "name_attribute": {
        "color": "#2e4a5a"
      },
      "name_class": {
        "color": "#866010",
        "bold": true
      },
      "name_constant": {
        "color": "#a04500"
      },
      "name_decorator": {
        "color": "#7a5a10"
      },
      "name_exception": {
        "color": "#a04540"
      },
      "name_function": {
        "color": "#7a5a10"
      },
      "name_other": {
        "color": "#20203e"
      },
      "literal": {
        "color": "#a04500"
      },
      "literal_number": {
        "color": "#a04500"
      },
      "literal_date": {
        "color": "#a04500"
      },
      "literal_string": {
        "color": "#3a7050"
      },
      "literal_string_escape": {
        "color": "#a04500"
      },
      "generic_deleted": {
        "color": "#d8a8a4"
      },
      "generic_inserted": {
        "color": "#b0c8a0"
      },
      "generic_emph": {
        "italic": true
      },
      "generic_strong": {
        "bold": true
      },
      "generic_subheading": {
        "color": "#4a3f2a"
      }
    }
  },
  "table": {
    "center_separator": "┼",
    "column_separator": "│",
    "row_separator": "─"
  },
  "definition_list": {},
  "definition_term": {},
  "definition_description": {
    "block_prefix": "\n→ "
  },
  "html_block": {},
  "html_span": {}
}
