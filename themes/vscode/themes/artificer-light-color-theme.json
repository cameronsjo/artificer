  "semanticHighlighting": true,
  "semanticTokenColors": {
    "namespace": "#3a6a68",
    "class": "#866010",
    "enum": "#866010",
    "interface": "#866010",
    "struct": "#866010",
    "typeParameter": "#866010",
    "type": "#866010",
    "parameter": {
      "foreground": "#2e4a5a",
      "fontStyle": "italic"
    },
    "variable": "#20203e",
    "property": "#20203e",
    "enumMember": "#a04500",
    "event": "#7a5a10",
    "function": "#7a5a10",
    "method": "#7a5a10",
    "macro": "#5a35b0",
    "label": "#20203e",
    "comment": "#5a7a8a",
    "string": "#3a7050",
    "keyword": "#5a35b0",
    "number": "#a04500",
    "regexp": "#3a7050",
    "operator": "#5a7a8a",
    "decorator": "#7a5a10",
    "*.declaration": {
      "bold": true
    },
    "*.readonly": "#a04500",
    "*.deprecated": {
      "strikethrough": true,
      "foreground": "#a04540"
    },
    "*.defaultLibrary": {
      "foreground": "#7a5a10"
    },
    "*.async": {
      "italic": true
    },
    "*.abstract": {
      "italic": true
    },
    "*.static": {
      "bold": true
    },
    "*.mutable": {
      "underline": true
    }
  },
  "tokenColors": [
    {
      "scope": [
        "comment",
        "punctuation.definition.comment"
      ],
      "settings": {
        "foreground": "#5a7a8a"
      }
    },
    {
      "scope": [
        "string",
        "string.quoted",
        "string.template"
      ],
      "settings": {
        "foreground": "#3a7050"
      }
    },
    {
      "scope": [
        "string.regexp"
      ],
      "settings": {
        "foreground": "#3a7050"
      }
    },
    {
      "scope": [
        "constant.numeric",
        "constant.language",
        "constant.character",
        "constant.other"
      ],
      "settings": {
        "foreground": "#a04500"
      }
    },
    {
      "scope": [
        "variable",
        "variable.other"
      ],
      "settings": {
        "foreground": "#20203e"
      }
    },
    {
      "scope": [
        "variable.parameter"
      ],
      "settings": {
        "foreground": "#2e4a5a",
        "fontStyle": "italic"
      }
    },
    {
      "scope": [
        "variable.language",
        "variable.language.this",
        "variable.language.self"
      ],
      "settings": {
        "foreground": "#5a35b0",
        "fontStyle": "italic"
      }
    },
    {
      "scope": [
        "keyword",
        "keyword.control",
        "storage",
        "storage.type"
      ],
      "settings": {
        "foreground": "#5a35b0"
      }
    },
    {
      "scope": [
        "storage.modifier"
      ],
      "settings": {
        "foreground": "#5a35b0",
        "fontStyle": "italic"
      }
    },
    {
      "scope": [
        "keyword.operator"
      ],
      "settings": {
        "foreground": "#5a7a8a"
      }
    },
    {
      "scope": [
        "punctuation",
        "meta.brace",
        "meta.delimiter"
      ],
      "settings": {
        "foreground": "#5a7a8a"
      }
    },
    {
      "scope": [
        "entity.name.function",
        "support.function",
        "meta.function-call"
      ],
      "settings": {
        "foreground": "#7a5a10"
      }
    },
    {
      "scope": [
        "entity.name.class",
        "entity.name.type",
        "entity.name.interface",
        "entity.name.enum",
        "support.class",
        "support.type"
      ],
      "settings": {
        "foreground": "#866010"
      }
    },
    {
      "scope": [
        "entity.name.namespace",
        "entity.name.module",
        "support.module",
        "support.namespace"
      ],
      "settings": {
        "foreground": "#3a6a68"
      }
    },
    {
      "scope": [
        "entity.name.tag",
        "entity.other.attribute-name"
      ],
      "settings": {
        "foreground": "#a04540"
      }
    },
    {
      "scope": [
        "markup.heading",
        "entity.name.section"
      ],
      "settings": {
        "foreground": "#7a5a10",
        "fontStyle": "bold"
      }
    },
    {
      "scope": [
        "heading.2.markdown entity.name.section"
      ],
      "settings": {
        "foreground": "#866010",
        "fontStyle": "bold"
      }
    },
    {
      "scope": [
        "heading.6.markdown entity.name.section"
      ],
      "settings": {
        "foreground": "#4a3f2a",
        "fontStyle": ""
      }
    },
    {
      "scope": [
        "markup.bold"
      ],
      "settings": {
        "fontStyle": "bold"
      }
    },
    {
      "scope": [
        "markup.italic"
      ],
      "settings": {
        "fontStyle": "italic"
      }
    },
    {
      "scope": [
        "markup.strikethrough"
      ],
      "settings": {
        "fontStyle": "strikethrough"
      }
    },
    {
      "scope": [
        "meta.paragraph.markdown markup.bold"
      ],
      "settings": {
        "foreground": "#866010",
        "fontStyle": "bold"
      }
    },
    {
      "scope": [
        "meta.paragraph.markdown markup.italic"
      ],
      "settings": {
        "foreground": "#2e4a5a",
        "fontStyle": "italic"
      }
    },
    {
      "scope": [
        "markup.inserted"
      ],
      "settings": {
        "foreground": "#2a5a3a"
      }
    },
    {
      "scope": [
        "markup.deleted"
      ],
      "settings": {
        "foreground": "#8a2418"
      }
    },
    {
      "scope": [
        "markup.changed"
      ],
      "settings": {
        "foreground": "#8a6618"
      }
    },
    {
      "scope": [
        "markup.quote"
      ],
      "settings": {
        "foreground": "#4a3f2a",
        "fontStyle": "italic"
      }
    },
    {
      "scope": [
        "punctuation.definition.list.begin"
      ],
      "settings": {
        "foreground": "#7a5a10"
      }
    },
    {
      "scope": [
        "markup.link",
        "markup.underline.link"
      ],
      "settings": {
        "foreground": "#3a6a68",
        "fontStyle": "underline"
      }
    },
    {
      "scope": [
        "string.other.link.title",
        "string.other.link.description"
      ],
      "settings": {
        "foreground": "#866010",
        "fontStyle": "bold"
      }
    },
    {
      "scope": [
        "markup.underline.link.image",
        "meta.image"
      ],
      "settings": {
        "foreground": "#5a35b0",
        "fontStyle": "underline"
      }
    },
    {
      "scope": [
        "markup.raw",
        "markup.inline.raw"
      ],
      "settings": {
        "foreground": "#3a7050"
      }
    },
    {
      "scope": [
        "markup.fenced_code.block"
      ],
      "settings": {
        "foreground": "#20203e"
      }
    },
    {
      "scope": [
        "fenced_code.block.language"
      ],
      "settings": {
        "foreground": "#4a3f2a"
      }
    },
    {
      "scope": [
        "meta.separator"
      ],
      "settings": {
        "foreground": "#cbb88a"
      }
    },
    {
      "scope": [
        "invalid",
        "invalid.illegal"
      ],
      "settings": {
        "foreground": "#a04540",
        "fontStyle": "italic"
      }
    },
    {
      "scope": [
        "invalid.deprecated"
      ],
      "settings": {
        "foreground": "#a04540",
        "fontStyle": "italic"
      }
    }
  ]
}
