  "semanticHighlighting": true,
  "semanticTokenColors": {
    "namespace": "#7da6a4",
    "class": "#e3c885",
    "enum": "#e3c885",
    "interface": "#e3c885",
    "struct": "#e3c885",
    "typeParameter": "#e3c885",
    "type": "#e3c885",
    "parameter": {
      "foreground": "#b8cad4",
      "fontStyle": "italic"
    },
    "variable": "#e8e6e1",
    "property": "#e8e6e1",
    "enumMember": "#d6936a",
    "event": "#dbbb6f",
    "function": "#dbbb6f",
    "method": "#dbbb6f",
    "macro": "#b095e0",
    "label": "#e8e6e1",
    "comment": "#5a7a8a",
    "string": "#5fa073",
    "keyword": "#b095e0",
    "number": "#d6936a",
    "regexp": "#5fa073",
    "operator": "#5a7a8a",
    "decorator": "#dbbb6f",
    "*.declaration": {
      "bold": true
    },
    "*.readonly": "#d6936a",
    "*.deprecated": {
      "strikethrough": true,
      "foreground": "#b85a55"
    },
    "*.defaultLibrary": {
      "foreground": "#dbbb6f"
    },
    "*.async": {
      "italic": true
    },
    "*.abstract": {
      "italic": true
    },
    "*.static": {
      "bold": true
    },
    "*.mutable": {
      "underline": true
    }
  },
  "tokenColors": [
    {
      "scope": [
        "comment",
        "punctuation.definition.comment"
      ],
      "settings": {
        "foreground": "#5a7a8a"
      }
    },
    {
      "scope": [
        "string",
        "string.quoted",
        "string.template"
      ],
      "settings": {
        "foreground": "#5fa073"
      }
    },
    {
      "scope": [
        "string.regexp"
      ],
      "settings": {
        "foreground": "#5fa073"
      }
    },
    {
      "scope": [
        "constant.numeric",
        "constant.language",
        "constant.character",
        "constant.other"
      ],
      "settings": {
        "foreground": "#d6936a"
      }
    },
    {
      "scope": [
        "variable",
        "variable.other"
      ],
      "settings": {
        "foreground": "#e8e6e1"
      }
    },
    {
      "scope": [
        "variable.parameter"
      ],
      "settings": {
        "foreground": "#b8cad4",
        "fontStyle": "italic"
      }
    },
    {
      "scope": [
        "variable.language",
        "variable.language.this",
        "variable.language.self"
      ],
      "settings": {
        "foreground": "#b095e0",
        "fontStyle": "italic"
      }
    },
    {
      "scope": [
        "keyword",
        "keyword.control",
        "storage",
        "storage.type"
      ],
      "settings": {
        "foreground": "#b095e0"
      }
    },
    {
      "scope": [
        "storage.modifier"
      ],
      "settings": {
        "foreground": "#b095e0",
        "fontStyle": "italic"
      }
    },
    {
      "scope": [
        "keyword.operator"
      ],
      "settings": {
        "foreground": "#5a7a8a"
      }
    },
    {
      "scope": [
        "punctuation",
        "meta.brace",
        "meta.delimiter"
      ],
      "settings": {
        "foreground": "#5a7a8a"
      }
    },
    {
      "scope": [
        "entity.name.function",
        "support.function",
        "meta.function-call"
      ],
      "settings": {
        "foreground": "#dbbb6f"
      }
    },
    {
      "scope": [
        "entity.name.class",
        "entity.name.type",
        "entity.name.interface",
        "entity.name.enum",
        "support.class",
        "support.type"
      ],
      "settings": {
        "foreground": "#e3c885"
      }
    },
    {
      "scope": [
        "entity.name.namespace",
        "entity.name.module",
        "support.module",
        "support.namespace"
      ],
      "settings": {
        "foreground": "#7da6a4"
      }
    },
    {
      "scope": [
        "entity.name.tag",
        "entity.other.attribute-name"
      ],
      "settings": {
        "foreground": "#b85a55"
      }
    },
    {
      "scope": [
        "markup.heading"
      ],
      "settings": {
        "foreground": "#dbbb6f",
        "fontStyle": "bold"
      }
    },
    {
      "scope": [
        "markup.bold"
      ],
      "settings": {
        "fontStyle": "bold",
        "foreground": "#e8e6e1"
      }
    },
    {
      "scope": [
        "markup.italic"
      ],
      "settings": {
        "fontStyle": "italic",
        "foreground": "#e8e6e1"
      }
    },
    {
      "scope": [
        "markup.inserted"
      ],
      "settings": {
        "foreground": "#4a8a5e"
      }
    },
    {
      "scope": [
        "markup.deleted"
      ],
      "settings": {
        "foreground": "#a04540"
      }
    },
    {
      "scope": [
        "markup.changed"
      ],
      "settings": {
        "foreground": "#c4808a"
      }
    },
    {
      "scope": [
        "markup.quote"
      ],
      "settings": {
        "foreground": "#c5c8c6",
        "fontStyle": "italic"
      }
    },
    {
      "scope": [
        "markup.link"
      ],
      "settings": {
        "foreground": "#dbbb6f"
      }
    },
    {
      "scope": [
        "markup.raw",
        "markup.inline.raw"
      ],
      "settings": {
        "foreground": "#5fa073"
      }
    },
    {
      "scope": [
        "invalid",
        "invalid.illegal"
      ],
      "settings": {
        "foreground": "#b85a55",
        "fontStyle": "italic"
      }
    },
    {
      "scope": [
        "invalid.deprecated"
      ],
      "settings": {
        "foreground": "#b85a55",
        "fontStyle": "italic"
      }
    }
  ]
}
