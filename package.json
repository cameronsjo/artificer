{
  "name": "@cameronsjo/artificer",
  "version": "0.22.1",
  "description": "Cameron's personal design system — AuDHD-friendly, dark-first, for tools and dashboards. Apache-2.0 but Cameron-first: published for my own reuse, unsupported, no stability guarantees implied.",
  "license": "Apache-2.0",
  "author": "Cameron Sjo",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cameronsjo/artificer.git"
  },
  "type": "module",
  "sideEffects": [
    "*.css",
    "src/artificer-*.js"
  ],
  "bin": {
    "artificer": "./bin/artificer.mjs"
  },
  "style": "./src/artificer.css",
  "exports": {
    "./artificer.css": "./src/artificer.css",
    "./whimsy.css": "./src/artificer-whimsy.css",
    "./texture.css": "./src/artificer-texture.css",
    "./editorial.css": "./src/artificer-editorial.css",
    "./print.css": "./src/print.css",
    "./theme.js": "./src/artificer-theme.js",
    "./focus.js": "./src/artificer-focus.js",
    "./tabs.js": "./src/artificer-tabs.js",
    "./options.js": "./src/artificer-options.js",
    "./tree.js": "./src/artificer-tree.js",
    "./icons.js": "./src/artificer-icons.js",
    "./whimsy.js": "./src/artificer-whimsy.js",
    "./tokens.json": "./src/tokens.json",
    "./package.json": "./package.json"
  },
  "files": [
    "src",
    "bin",
    "reference/SKILL.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build:themes": "node themes/build.mjs",
    "build:livespec": "node scripts/build-livespec.mjs",
    "check:livespec": "node scripts/build-livespec.mjs --check",
    "check:contrast": "node scripts/check-syntax-contrast.mjs",
    "lint:palette": "node scripts/lint-css-palette.mjs",
    "check:version": "node scripts/sync-version.mjs --check",
    "sync:version": "node scripts/sync-version.mjs",
    "check:tokens": "node scripts/sync-tokens.mjs --check",
    "sync:tokens": "node scripts/sync-tokens.mjs",
    "sri": "node scripts/gen-sri.mjs",
    "test": "node --test scripts/*.test.mjs"
  }
}
